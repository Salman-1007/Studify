generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EducationLevel {
  SCHOOL
  COLLEGE
  UNIVERSITY
  OTHER
}

enum Role {
  STUDENT
  ADMIN
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  MODERATOR
  MEMBER
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id             String   @id @default(uuid())
  name           String
  username       String   @unique
  email          String   @unique
  passwordHash   String
  educationLevel EducationLevel @default(OTHER)
  grade          String?
  board          String?  @default("Punjab")
  level          Int      @default(1)
  institution    String?
  avatarUrl      String?
  role           Role     @default(STUDENT)
  isActive       Boolean  @default(true)
  points         Int      @default(0)
  streakCount    Int      @default(0)
  lastStudyDate  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  refreshTokens       RefreshToken[]
  conversations       Conversation[]
  materials           Material[]
  quizzesCreated      Quiz[]              @relation("QuizCreator")
  quizAttempts        QuizAttempt[]
  flashcardDecks      FlashcardDeck[]
  ownedGroups         StudyGroup[]        @relation("GroupOwner")
  groupMemberships    GroupMember[]
  groupMessages       GroupMessage[]
  groupQuizAttempts   GroupQuizParticipant[]
  notifications       Notification[]
  achievements        UserAchievement[]
  studySessions       StudySession[]
  topicPerformances   UserTopicPerformance[]
  standardTestAttempts StandardTestAttempt[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  materialId String?
  material  Material? @relation(fields: [materialId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Material {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  fileUrl     String?
  extractedText String?
  createdAt   DateTime @default(now())

  conversations Conversation[]
  chunks        MaterialChunk[]
  quizzes       Quiz[]

  @@index([userId])
}

model MaterialChunk {
  id         String   @id @default(uuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  createdAt  DateTime @default(now())

  @@index([materialId])
}

model Quiz {
  id          String         @id @default(uuid())
  title       String
  topic       String
  subject     String?
  difficulty  QuizDifficulty @default(MEDIUM)
  creatorId   String
  creator     User           @relation("QuizCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  materialId  String?
  material    Material?      @relation(fields: [materialId], references: [id])
  source      String         @default("ai")
  createdAt   DateTime       @default(now())

  questions   Question[]
  attempts    QuizAttempt[]
  groupQuizzes GroupQuiz[]

  @@index([creatorId])
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  type          QuestionType
  options       Json?
  correctAnswer String
  explanation   String?
  order         Int          @default(0)

  questionAttempts QuestionAttempt[]

  @@index([quizId])
}

model QuizAttempt {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Int
  totalQuestions Int
  percentage    Float
  timeTakenSecs Int
  createdAt     DateTime @default(now())

  questionAttempts QuestionAttempt[]

  @@index([userId])
  @@index([quizId])
}

model QuestionAttempt {
  id            String      @id @default(uuid())
  quizAttemptId String
  quizAttempt   QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  givenAnswer   String
  isCorrect     Boolean

  @@index([quizAttemptId])
}

model FlashcardDeck {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  topic     String?
  createdAt DateTime @default(now())

  cards Flashcard[]

  @@index([userId])
}

model Flashcard {
  id       String  @id @default(uuid())
  deckId   String
  deck     FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front    String
  back     String
  dueAt    DateTime @default(now())
  interval Int      @default(1)

  reviews FlashcardReview[]

  @@index([deckId])
}

model FlashcardReview {
  id          String    @id @default(uuid())
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  rating      String
  reviewedAt  DateTime  @default(now())

  @@index([flashcardId])
}

model StudyGroup {
  id          String       @id @default(uuid())
  name        String
  description String?
  subject     String?
  privacy     GroupPrivacy @default(PUBLIC)
  joinCode    String       @unique
  ownerId     String
  owner       User         @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  members    GroupMember[]
  messages   GroupMessage[]
  groupQuizzes GroupQuiz[]

  @@index([ownerId])
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String     @id @default(uuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime   @default(now())

  @@index([groupId])
}

model GroupQuiz {
  id        String   @id @default(uuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  status    String   @default("pending")
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime @default(now())

  participants GroupQuizParticipant[]

  @@index([groupId])
}

model GroupQuizParticipant {
  id           String    @id @default(uuid())
  groupQuizId  String
  groupQuiz    GroupQuiz @relation(fields: [groupQuizId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int?
  timeTakenSecs Int?
  submittedAt  DateTime?

  @@unique([groupQuizId, userId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Achievement {
  id          String @id @default(uuid())
  code        String @unique
  title       String
  description String

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

model StudySession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes   Int
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserTopicPerformance {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic        String
  subject      String?
  correctCount Int      @default(0)
  totalCount   Int      @default(0)
  isWeak       Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([userId, topic])
  @@index([userId])
}

enum QuestionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SourceType {
  ORIGINAL
  IMPORTED
  AI_GENERATED
}

model Board {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects    CurriculumSubject[]
  questions   QuestionBankItem[]
  testAttempts StandardTestAttempt[]
}

model CurriculumSubject {
  id          String   @id @default(uuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  classGrade  String   // e.g. "9"
  subjectName String   // e.g. "Physics"
  bookName    String   // e.g. "Physics 9"
  code        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters    CurriculumChapter[]
  questions   QuestionBankItem[]
  testAttempts StandardTestAttempt[]

  @@unique([boardId, classGrade, subjectName])
  @@index([boardId, classGrade])
}

model CurriculumChapter {
  id            String   @id @default(uuid())
  subjectId     String
  subject       CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterNumber Int
  chapterName   String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topics        CurriculumTopic[]
  questions     QuestionBankItem[]
  testAttempts  StandardTestAttempt[]

  @@unique([subjectId, chapterNumber])
  @@index([subjectId])
}

model CurriculumTopic {
  id          String   @id @default(uuid())
  chapterId   String
  chapter     CurriculumChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicName   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   QuestionBankItem[]

  @@unique([chapterId, topicName])
  @@index([chapterId])
}

model QuestionBankItem {
  id              String         @id @default(uuid())
  boardId         String
  board           Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  classGrade      String         // e.g. "9"
  subjectId       String
  subject         CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         CurriculumChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicId         String?
  topic           CurriculumTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  questionText    String
  normalizedText  String         // lowercased, stripped for duplicate detection

  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String         // "A" | "B" | "C" | "D"
  explanation     String?
  difficulty      QuizDifficulty @default(MEDIUM)
  status          QuestionStatus @default(PENDING_REVIEW)
  questionType    QuestionType   @default(MCQ)

  sourceType      SourceType     @default(ORIGINAL)
  sourceReference String?

  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  testQuestions   StandardQuestionAttempt[]

  @@index([boardId, classGrade, subjectId, chapterId, status])
  @@index([status])
  @@index([chapterId, normalizedText])
}

model StandardTestAttempt {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  boardId          String
  board            Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  classGrade       String
  subjectId        String
  subject          CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId        String
  chapter          CurriculumChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  questionCount    Int
  difficulty       String   @default("MIXED")

  score            Int      @default(0)
  totalQuestions   Int
  percentage       Float    @default(0)
  correctCount     Int      @default(0)
  wrongCount       Int      @default(0)
  unansweredCount  Int      @default(0)
  timeTakenSecs    Int      @default(0)

  isSubmitted      Boolean  @default(false)
  startedAt        DateTime @default(now())
  submittedAt      DateTime?
  createdAt        DateTime @default(now())

  questionAttempts StandardQuestionAttempt[]

  @@index([userId])
  @@index([subjectId])
}

model StandardQuestionAttempt {
  id               String               @id @default(uuid())
  testAttemptId    String
  testAttempt      StandardTestAttempt  @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         QuestionBankItem     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  order            Int                  @default(0)
  selectedOption   String?              // "A" | "B" | "C" | "D" or null
  isCorrect        Boolean              @default(false)

  @@index([testAttemptId])
}
