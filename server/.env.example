# ==== Server ====
NODE_ENV=development
PORT=5000

# ==== Database (Neon Postgres) ====
# Get this from your Neon project dashboard -> Connection string
DATABASE_URL=postgresql://neondb_owner:...@ep-...-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ==== Auth ====
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# ==== AI Providers (Gemini / Groq) ====
# Gemini API Key (recommended): Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (fallback): Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Provider selector: 'gemini' | 'groq' | 'custom'
AI_PROVIDER=gemini

# ==== CORS ====
CLIENT_URL=http://localhost:5173,https://studify-ochre.vercel.app

# ==== File uploads ====
UPLOAD_PROVIDER=local
